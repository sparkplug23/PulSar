        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button id="b7_0" type="button" onclick="SendCmd(7,0)">Off</button>
          <button id="b7_1" type="button" onclick="SendCmd(7,1)">On</button>
          <button id="b7_2" type="button" onclick="SendCmd(7,2)">Toggle 7s</button>
        </div>

        <div style="flex:1;min-width:220px;">
          <b>Status:</b><br>
          <input id="T7" name="T7" type="text" readonly value="" style="width:100%;">
        </div>
      </div>
    </div>

  </div>

  <hr>

  <h3>Update time</h3>
  <input type="text" name="UT" readonly value="" style="width:220px;">

  <hr>

  <!-- Keep only top Back/Save. -->
</form>
</body>
</html>
