          <button id="b1_1" type="button" onclick="SendCmd(1,1)">On</button>
          <button id="b1_2" type="button" onclick="SendCmd(1,2)">Toggle 7s</button>
        </div>

        <div style="flex:1;min-width:220px;">
          <b>Status:</b><br>
          <input id="T1" name="T1" type="text" readonly value="" style="width:100%;">
        </div>
      </div>
    </div>

    <!-- ROW 2 -->
