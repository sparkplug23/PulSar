        <div style="min-width:190px;">
          <b>Relay 6:</b><br>
          <input type="text" name="R5" maxlength="32" style="width:180px;">
        </div>

        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button id="b5_0" type="button" onclick="SendCmd(5,0)">Off</button>
          <button id="b5_1" type="button" onclick="SendCmd(5,1)">On</button>
          <button id="b5_2" type="button" onclick="SendCmd(5,2)">Toggle 7s</button>
        </div>

        <div style="flex:1;min-width:220px;">
          <b>Status:</b><br>
          <input id="T5" name="T5" type="text" readonly value="" style="width:100%;">
        </div>
      </div>
    </div>

    <!-- ROW 6 -->
    <div id="row6" style="padding:10px 8px;margin:8px 0;border-left:6px solid #666;">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div style="min-width:190px;">
          <b>Relay 7:</b><br>
          <input type="text" name="R6" maxlength="32" style="width:180px;">
        </div>

        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button id="b6_0" type="button" onclick="SendCmd(6,0)">Off</button>
          <button id="b6_1" type="button" onclick="SendCmd(6,1)">On</button>
