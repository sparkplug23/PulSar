      </div>
    </div>

    <!-- ROW 3 -->
    <div id="row3" style="padding:10px 8px;margin:8px 0;border-left:6px solid #666;">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div style="min-width:190px;">
          <b>Relay 4:</b><br>
          <input type="text" name="R3" maxlength="32" style="width:180px;">
