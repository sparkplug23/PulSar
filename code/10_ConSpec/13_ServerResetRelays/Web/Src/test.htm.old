<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <title>PulSar Module: Server Reset Relays</title>

  <!-- Shared WebServer helpers (absolute paths). DO NOT use async (WLED-style dependency). -->
  <script src="/common.js"></script>
  <style>@import url("/style.css");</style>

  <script>
    // Date Modified: 05Jan26

    // ------------------------------------------------------------------------
    // Contract
    //   - Single POST endpoint: /m/serverrelays
    //   - Module JS endpoint:   /m/serverrelays/s.js?p=1
    //
    // POST fields:
    //   - A   : action selector ("save" by default)
    //   - R0..R7 : relay display names (optional rename)
    //   - C   : command selector (string token)
    //
    // Command token format (example):
    //   RB0_0  => Relay 0, Button 0 (Off)
    //   RB3_1  => Relay 3, Button 1 (On)
    //   RB5_2  => Relay 5, Button 2 (Toggle 7s)
    //
    // Talk-back fields (via GetV JS):
    //   - R0..R7  names
    //   - S0..S7  state (0/1) for styling
    //   - T0..T7  text feedback (countdown/status)
    //   - UT      update-time string
    // ------------------------------------------------------------------------

    const RELAY_COUNT = 8;
    const CMD_OFF     = 0;
    const CMD_ON      = 1;
    const CMD_TOGGLE5 = 2;

    function S() {
      getLoc();

      // Load module-specific settings JS (sync, WLED pattern)
      loadJS(getURL("/m/serverrelays/s.js?p=1"), false);

      // POST target (same path)
      if (loc) d.Sf.action = getURL("/m/serverrelays");
    }

    function SendCmd(relayIndex, cmdIndex) {
      // Encode command token RB<relay>_<cmd>
      gId("C").value = "RB" + relayIndex + "_" + cmdIndex;
      gId("A").value = "cmd";
      d.Sf.submit();
    }

    // Styling helper: called by GetV() talk-back (optional)
    function SetRelayState(relayIndex, isOn) {
      const row = gId("row" + relayIndex);
      if (!row) return;

      // If you later add real CSS classes in /style.css, you can switch to classList.
      // For now keep inline: robust and local.
      row.style.borderLeft = isOn ? "6px solid #2ecc71" : "6px solid #e74c3c";

      // Button emphasis (optional)
      const bOff = gId("b" + relayIndex + "_0");
      const bOn  = gId("b" + relayIndex + "_1");
      if (bOff) bOff.style.opacity = isOn ? "0.55" : "1.0";
      if (bOn)  bOn.style.opacity  = isOn ? "1.0"  : "0.55";
    }

    // Text feedback helper: called by GetV() talk-back (optional)
    function SetRelayText(relayIndex, text) {
      const e = gId("T" + relayIndex);
      if (!e) return;
      e.value = (text === undefined || text === null) ? "" : String(text);
    }
  </script>
</head>

<body onload="S()">
<form id="form_s" name="Sf" method="post">

  <div class="toprow">
    <button type="button" onclick="B()">Back</button>
    <button type="submit" onclick="gId('A').value='save'">Save</button><hr>
  </div>

  <h2>Server Reset Relays</h2>

  <!-- Hidden selectors -->
  <input type="hidden" id="A" name="A" value="save">
  <input type="hidden" id="C" name="C" value="">

  <hr>

  <!-- Relay rows -->
  <div id="rows">

    <!-- ROW 0 -->
    <div id="row0" style="padding:10px 8px;margin:8px 0;border-left:6px solid #666;">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div style="min-width:190px;">
          <b>Relay 1:</b><br>
          <input type="text" name="R0" maxlength="32" style="width:180px;">
        </div>

        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button id="b0_0" type="button" onclick="SendCmd(0,0)">Off</button>
          <button id="b0_1" type="button" onclick="SendCmd(0,1)">On</button>
          <button id="b0_2" type="button" onclick="SendCmd(0,2)">Toggle 7s</button>
        </div>

        <div style="flex:1;min-width:220px;">
          <b>Status:</b><br>
          <input id="T0" name="T0" type="text" readonly value="" style="width:100%;">
        </div>
      </div>
    </div>

    <!-- ROW 1 -->
    <div id="row1" style="padding:10px 8px;margin:8px 0;border-left:6px solid #666;">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
