    <!-- ROW 7 -->
    <div id="row7" style="padding:10px 8px;margin:8px 0;border-left:6px solid #666;">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div style="min-width:190px;">
          <b>Relay 8:</b><br>
          <input type="text" name="R7" maxlength="32" style="width:180px;">
